{
  // Spark OS — Cloudflare Worker (full-stack: Hono API + static React SPA).
  // Deploy with `npm run deploy` (runs the Vite build, then `wrangler deploy`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spark-os",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Same directory Vite builds into and GitHub Pages publishes from.
    "directory": "./docs",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  // Core data model lives in D1 (SQLite). Migrations are in ./migrations and
  // applied with `pnpm db:migrate:local` / `pnpm db:migrate`. The placeholder
  // database_id is replaced by the real id once Cloudflare account access is
  // restored (see README → Deploy); local dev works without it via `--local`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spark-os",
      "database_id": "PLACEHOLDER_RUN_wrangler_d1_create_spark-os",
      "migrations_dir": "migrations"
    }
  ]
  // Added in a later M1 task:
  // "ai": { "binding": "AI" }
}
